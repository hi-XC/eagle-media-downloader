{
  "name": "eagle-media-downloader",
  "version": "0.1.0",
  "description": "Eagle plugin for downloading mixed image and video posts",
  "main": "js/plugin.js",
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "node esbuild.config.js --watch",
    "test": "node --test",
    "prepublish": "npm run build && rm -rf Plugin/bin/",
    "package": "npm run build && rm -rf Plugin/bin/ && cd Plugin && zip -r ../媒体下载器-开发版.eagleplugin ."
  },
  "dependencies": {
    "i18next": "^25.8.19"
  },
  "devDependencies": {
    "esbuild": "^0.19.0"
  },
  "keywords": [
    "eagle",
